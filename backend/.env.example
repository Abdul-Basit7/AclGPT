# Required: embeddings for uploaded documents
GOOGLE_API_KEY=your_google_api_key

# Required: the chat model
GROQ_API_KEY=your_groq_api_key

# Required in production: sign JWTs with a long random string
# generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me

# Optional: OAuth sign-in. Leave a pair blank and that button is simply not shown.
# Google:  https://console.cloud.google.com/apis/credentials
#   Authorised redirect URI: http://127.0.0.1:8000/api/auth/oauth/google/callback
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
#
# GitHub:  https://github.com/settings/developers  (New OAuth App)
#   Authorization callback URL: http://127.0.0.1:8000/api/auth/oauth/github/callback
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# Optional overrides
# FRONTEND_URL=http://localhost:5173
# DATA_DIR=data
# CORS_ORIGINS=http://localhost:5173
# EMBEDDING_MODEL=models/gemini-embedding-001
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# RETRIEVAL_K=5
# RETRIEVAL_FETCH_K=20
# HISTORY_TURNS=6
# MAX_UPLOAD_MB=25
# ACCESS_TOKEN_EXPIRE_MINUTES=10080
